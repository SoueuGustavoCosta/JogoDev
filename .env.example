# Copie para .env.local (não vai para o Git) só se quiser testar o envio de eventos localmente.
# Em produção, configure estas variáveis na Vercel: Project → Settings → Environment Variables.
# Sem VITE_POSTHOG_KEY os eventos não são enviados a lugar nenhum (o app funciona igual).

# Chave pública do projeto no PostHog (Project settings → Project API key, começa com phc_).
VITE_POSTHOG_KEY=
# Região escolhida ao criar o projeto: https://us.i.posthog.com ou https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
